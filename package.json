{
  "name": "papertable-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --env-file-if-exists=.env.local server/index.mjs\" \"vite --host 127.0.0.1 --port ${PAPERTABLE_WEB_PORT:-5173}\"",
    "dev:web": "vite --host 127.0.0.1 --port ${PAPERTABLE_WEB_PORT:-5173}",
    "dev:api": "node --env-file-if-exists=.env.local server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env.local server/index.mjs --serve-dist",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test \"src/**/*.test.ts\" \"server/**/*.test.mjs\"",
    "test:watch": "tsx --test --watch \"src/**/*.test.ts\" \"server/**/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "framer-motion": "^11.11.17",
    "jszip": "^3.10.1",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.7.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.17.0"
}
